const COACH = {
  // ─── AGENT STATUS ────────────────────────────────────────
  status: "bereit",
  focus: null,
  solution: null,

  // ─── LEBENSBEREICHE ─────────────────────────────────────
  areas: {
    wohnen: {
      label: "🏠 Wohnen",
      issues: ["miete zu hoch","wohnungssuche","schimmel","kündigung","umzug","miete","wohnung"],
      help: ["Mietberatung","Wohnungsamt","Sozialhilfe","Mieterverein"],
      folder: "Wohnen"
    },
    arbeit: {
      label: "💼 Arbeit & Job",
      issues: ["arbeitslosigkeit","arbeitslos","bewerbung","kündigung","mobbing","überforderung","arbeit","job","chef"],
      help: ["Arbeitsamt","Jobcenter","Bewerbungscoaching","Rechtsberatung"],
      folder: "Arbeit"
    },
    gesundheit: {
      label: "❤️ Gesundheit",
      issues: ["krankheit","krank","psychische belastung","sucht","suchthilfe","pflege","krankenkasse","gesundheit"],
      help: ["Krankenkasse","Sozialpsychiatrie","Suchtberatung","Pflegestützpunkt"],
      folder: "Persönlichkeit"
    },
    finanzen: {
      label: "💰 Finanzen",
      issues: ["schulden","alg ii","bürgergeld","steuern","kredite","finanzen","geld"],
      help: ["Schuldnerberatung","Jobcenter","Finanzamt","Verbraucherzentrale"],
      folder: "Wohnen"
    },
    familie: {
      label: "👨‍👩‍👧 Familie & Soziales",
      issues: ["kinderbetreuung","sorgerecht","gewalt","trennung","altersvorsorge","familie","kinder"],
      help: ["Jugendamt","Familienberatung","Hilfetelefon","Sozialamt"],
      folder: "Persönlichkeit"
    },
    behoerden: {
      label: "🏛️ Behörden",
      issues: ["behörde","behörden","amt","antrag","formular","termin","ausländerbehörde","aufenthalt"],
      help: ["Bürgeramt","Ausländerbehörde","Sozialamt","Bürgertelefon 115"],
      folder: "Mobilität"
    },
    jobcenter: {
      label: "🏛️ Jobcenter",
      issues: ["jobcenter","alg i","alg ii","eingliederung","vermittlung"],
      help: ["Jobcenter Terminvereinbarung","Arbeitsamt","Sozialberatung"],
      folder: "Arbeit"
    }
  },

  // ─── ÄMTER ──────────────────────────────────────────────
  aemter: {
    jobcenter:       { label:"🏛️ Jobcenter",       contact:"Terminvereinbarung",  tasks:["ALG II","Bürgergeld","Eingliederung"] },
    arbeitsamt:      { label:"🏛️ Arbeitsamt",      contact:"Online-Portal",       tasks:["Arbeitslosengeld","Weiterbildung","Vermittlung"] },
    wohnungsamt:     { label:"🏛️ Wohnungsamt",     contact:"Stadtverwaltung",     tasks:["Wohnberechtigungsschein","Sozialwohnung"] },
    jugendamt:       { label:"🏛️ Jugendamt",       contact:"Telefon + Beratung",  tasks:["Kinderbetreuung","Sorgerecht","Hilfe"] },
    sozialamt:       { label:"🏛️ Sozialamt",       contact:"Persönlich oder Online", tasks:["Sozialhilfe","Grundsicherung"] },
    gesundheitsamt:  { label:"🏛️ Gesundheitsamt",  contact:"Termin",              tasks:["Impfung","Gesundheitszeugnis","Hygiene"] },
    finanzamt:       { label:"🏛️ Finanzamt",       contact:"Online + Telefon",    tasks:["Steuererklärung","Steuer-ID","Freistellungsauftrag"] },
    auslaenderbehoerde: { label:"🏛️ Ausländerbehörde", contact:"Termin",          tasks:["Aufenthaltstitel","Einbürgerung","Fiktionsbescheinigung"] },
    rentenversicherung: { label:"🏛️ Rentenversicherung", contact:"Online + Telefon", tasks:["Rentenantrag","Kontenklärung"] },
    krankenkasse:    { label:"🏥 Krankenkasse",    contact:"Online + Telefon",    tasks:["Leistungen","Krankmeldung","Anträge"] }
  },

  // Bereich → Ämter-Zuordnung
  areaToAemter: {
    wohnen:     ["wohnungsamt","sozialamt"],
    arbeit:     ["jobcenter","arbeitsamt"],
    gesundheit: ["gesundheitsamt","krankenkasse"],
    finanzen:   ["finanzamt","jobcenter"],
    familie:    ["jugendamt","sozialamt"],
    behoerden:  ["auslaenderbehoerde","sozialamt","finanzamt"],
    jobcenter:  ["jobcenter","arbeitsamt"]
  },

  // ─── SOLVE ──────────────────────────────────────────────
  solve(problem, forcedArea) {
    const match = forcedArea
      ? this.makeMatch(forcedArea)
      : this.matchProblem(problem);

    if (!match) return this.fallback(problem);

    const solution = {
      area: match.area,
      issue: match.issue,
      help: match.help,
      folder: this.areas[match.area]?.folder || "—",
      aemter: this.findAemter(match.area),
      steps: this.generateSteps(match),
      resources: this.findResources(match)
    };

    this.solution = solution;
    this.focus = match.area;
    return solution;
  },

  makeMatch(areaKey) {
    const a = this.areas[areaKey];
    if (!a) return null;
    return { area: areaKey, issue: a.issues[0] || areaKey, help: a.help };
  },

  // Längster Treffer zuerst — spezifischer gewinnt
  matchProblem(input) {
    const lower = (input || "").toLowerCase();
    if (!lower) return null;
    let best = null, bestLen = 0;
    for (const [key, area] of Object.entries(this.areas)) {
      for (const issue of area.issues) {
        if (lower.includes(issue) && issue.length > bestLen) {
          best = { area: key, issue, help: area.help };
          bestLen = issue.length;
        }
      }
    }
    return best;
  },

  findAemter(areaKey) {
    const keys = this.areaToAemter[areaKey] || [];
    return keys
      .map(k => this.aemter[k] ? { key: k, ...this.aemter[k] } : null)
      .filter(Boolean);
  },

  generateSteps(match) {
    return [
      `Erste Anlaufstelle: ${match.help[0]}`,
      "Unterlagen vorbereiten: Personalausweis, Nachweise",
      "Termin vereinbaren (Telefon oder Online)",
      "Beratung wahrnehmen, Lösung erarbeiten",
      "Bei Bedarf: Folge-Termin oder Antrag stellen"
    ];
  },

  findResources(match) {
    return {
      online:  `www.${match.area}-hilfe.de`,
      vorort:  `Nächste Beratungsstelle für ${match.area}`,
      telefon: "Telefon 115 (Behörden-Hotline Deutschland, kostenlos)",
      notfall: "Bei akuter Krise: 112 oder 110"
    };
  },

  fallback(input) {
    return {
      status: "🔍 unklar",
      message: "Problem nicht eindeutig erkannt. Bitte genauer beschreiben.",
      help: "Sage z.B. 'wohnung', 'arbeit', 'gesundheit', 'schulden', 'familie', 'behörden'",
      aemter: [],
      steps: [
        "Problem klar beschreiben",
        "Bereich wählen",
        "Hilfe holen"
      ]
    };
  },

  // ─── SENSE · Verhandlung ────────────────────────────────
  sense() {
    const states = {
      ghost: "Problem nicht erkannt",
      help:  "Hilfe wird benötigt",
      error: "Problem dringend",
      miss:  "Information fehlt",
      fit:   "Lösung in Arbeit",
      fin:   "Problem gelöst",
      rdy:   "Bereit für nächste Hilfe"
    };
    const key = this.solution ? "fit" : "rdy";
    return { state: key, description: states[key] };
  },

  // ─── VERHANDLUNG · Einzelentscheidung ──────────────────
  // Nutzer entscheidet, ob er's annimmt. Kein Zwang.
  negotiate(problem, answer) {
    const sol = this.solve(problem);

    switch (answer) {
      case "ja":
        // Nutzer nimmt die Lösung an
        return { ok: true, action: "angenommen", solution: sol };

      case "nein":
        // Nutzer lehnt ab — nicht nachbohren
        this.solution = null;
        return { ok: true, action: "abgelehnt", message: "Ok. Nichts weiter." };

      case "später":
        return { ok: true, action: "später", message: "Ok. In 30 min nochmal." };

      case "heute nicht":
        return { ok: true, action: "heute-nicht", message: "Ok. Ruhe bis morgen." };

      case "nie":
        return { ok: true, action: "nie", message: "Verstanden. Nie mehr." };

      default:
        // Unklar → zeig was drin ist, frag nochmal
        return { ok: false, action: "frage", solution: sol };
    }
  }
};

// ─── EXPORT ─────────────────────────────────────────────
export { COACH };
